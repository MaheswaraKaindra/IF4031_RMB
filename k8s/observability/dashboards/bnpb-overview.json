{
 "title": "BNPB overview",
 "uid": "bnpb-overview",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "10s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "DS_PROMETHEUS",
    "type": "datasource",
    "query": "prometheus",
    "hide": 2
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Throughput (req/s) per service",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (service) (rate(http_requests_total[1m]))",
     "legendFormat": "{{service}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Error rate (5xx share) per service",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (service) (rate(http_requests_total{status=~\"5..\"}[1m])) / sum by (service) (rate(http_requests_total[1m]))",
     "legendFormat": "{{service}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Latency p95 per service",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum by (le, service) (rate(http_request_duration_seconds_bucket[1m])))",
     "legendFormat": "{{service}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Controlled rejections (429) per service",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (service) (rate(http_requests_total{status=\"429\"}[1m]))",
     "legendFormat": "{{service}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Memory working set per pod (compare with Appendix B limit)",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 16
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "container_memory_working_set_bytes{container!=\"\"}",
     "legendFormat": "{{pod}} ({{node}})",
     "refId": "A"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Scrape targets up",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 16
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "up{job=\"bnpb-pods\"}",
     "legendFormat": "{{service}} {{pod}}",
     "refId": "A"
    }
   ]
  }
 ]
}